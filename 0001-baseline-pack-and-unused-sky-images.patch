diff --git a/packages/packsquash/src/optifine_sky.rs b/packages/packsquash/src/optifine_sky.rs
new file mode 100644
index 0000000..e376b59
--- /dev/null
+++ b/packages/packsquash/src/optifine_sky.rs
@@ -0,0 +1,73 @@
+//! Support for finding OptiFine custom sky images that no custom sky entry uses, which
+//! are dead weight in a pack.
+
+use std::path::Path;
+
+use crate::vfs::{IteratorTraversalOptions, VirtualFileSystem, read_file};
+
+#[cfg(test)]
+mod tests;
+
+/// The directory where OptiFine looks for custom sky entries (`.properties` files) and the
+/// images they use.
+const SKY_DIRECTORY: &str = "assets/minecraft/optifine/sky/";
+
+/// Detects the images of OptiFine custom skies that are not used by any custom sky entry.
+pub(crate) struct UnusedSkyImageDetector {
+	/// The concatenated contents of every custom sky entry, or `None` if there are no
+	/// entries or they could not be read. In that case, no image is considered unused.
+	sky_entries_text: Option<String>
+}
+
+impl UnusedSkyImageDetector {
+	/// Reads the custom sky entries of the pack in the given directory.
+	pub(crate) async fn scan<V: VirtualFileSystem>(
+		vfs: &V,
+		pack_directory: &Path,
+		iterator_traversal_options: IteratorTraversalOptions
+	) -> Self {
+		let mut sky_entries_text: Option<String> = None;
+
+		// Errors while iterating the pack files are not handled here: the main pack
+		// processing loop will report them
+		for pack_file in vfs
+			.file_iterator(pack_directory, iterator_traversal_options)
+			.flatten()
+		{
+			let relative_path = pack_file.relative_path.as_str();
+
+			if relative_path.starts_with(SKY_DIRECTORY) && relative_path.ends_with(".properties") {
+				let Some(entry_data) = read_file(vfs, &pack_file.file_path).await else {
+					// Being unable to know what is used means that nothing can be
+					// safely considered unused
+					return Self {
+						sky_entries_text: None
+					};
+				};
+
+				let text = sky_entries_text.get_or_insert_with(String::new);
+				text.push_str(&String::from_utf8_lossy(&entry_data));
+				text.push('\n');
+			}
+		}
+
+		Self { sky_entries_text }
+	}
+
+	/// Checks whether the pack file at the given relative path is a custom sky image that no
+	/// custom sky entry uses. An image is considered used if any entry mentions its file name,
+	/// which is a conservative approximation of how entries refer to images.
+	pub(crate) fn is_unused(&self, relative_path: &str) -> bool {
+		let Some(sky_entries_text) = &self.sky_entries_text else {
+			return false;
+		};
+
+		relative_path
+			.strip_prefix(SKY_DIRECTORY)
+			.filter(|path_in_sky_directory| path_in_sky_directory.ends_with(".png"))
+			.is_some_and(|_| {
+				let file_name = relative_path.rsplit('/').next().unwrap_or(relative_path);
+				!sky_entries_text.contains(file_name)
+			})
+	}
+}
diff --git a/packages/packsquash/src/optifine_sky/tests.rs b/packages/packsquash/src/optifine_sky/tests.rs
new file mode 100644
index 0000000..1e5c838
--- /dev/null
+++ b/packages/packsquash/src/optifine_sky/tests.rs
@@ -0,0 +1,142 @@
+use std::fs;
+
+use flate2::Compression;
+
+use super::*;
+use crate::baseline_pack::ZipArchive;
+use crate::baseline_pack::tests::{png, temp_dir, write_file};
+use crate::config::{GlobalOptions, MinecraftMod, SquashOptions};
+use crate::vfs::os_fs::OsFilesystem;
+use crate::{PackSquasher, PackSquasherStatus};
+
+const SKY_ENTRY: &[u8] = b"source=./cloud.png\nstartFadeIn=6:00\nendFadeIn=7:00\n";
+
+async fn detector(pack_dir: &Path) -> UnusedSkyImageDetector {
+	UnusedSkyImageDetector::scan(&OsFilesystem, pack_dir, IteratorTraversalOptions::default()).await
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 1)]
+async fn images_not_named_by_any_entry_are_unused() {
+	let pack_dir = temp_dir();
+	write_file(
+		pack_dir.path(),
+		"assets/minecraft/optifine/sky/world0/sky1.properties",
+		SKY_ENTRY
+	);
+
+	let detector = detector(pack_dir.path()).await;
+
+	assert!(!detector.is_unused("assets/minecraft/optifine/sky/world0/cloud.png"));
+	assert!(detector.is_unused("assets/minecraft/optifine/sky/world0/leftover.png"));
+	// Only sky images are considered
+	assert!(!detector.is_unused("assets/minecraft/optifine/colormap/leftover.png"));
+	assert!(!detector.is_unused("assets/minecraft/optifine/sky/world0/sky1.properties"));
+	assert!(!detector.is_unused("assets/minecraft/textures/blocks/leftover.png"));
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 1)]
+async fn nothing_is_unused_without_sky_entries() {
+	let pack_dir = temp_dir();
+	write_file(
+		pack_dir.path(),
+		"assets/minecraft/optifine/sky/world0/leftover.png",
+		b""
+	);
+
+	assert!(
+		!detector(pack_dir.path())
+			.await
+			.is_unused("assets/minecraft/optifine/sky/world0/leftover.png")
+	);
+}
+
+/// Not async because `PackSquasher::run` starts its own runtime.
+#[test]
+fn squashing_leaves_out_unused_sky_images_only_if_asked() {
+	let sky_image = png(1, 1, &[1, 2, 3, 255], Compression::best());
+
+	for (skip_unused_images, allow_optifine) in [(true, true), (false, true), (true, false)] {
+		let (pack_dir, output_dir) = (temp_dir(), temp_dir());
+
+		write_file(
+			pack_dir.path(),
+			"pack.mcmeta",
+			br#"{"pack": {"pack_format": 1, "description": "Test pack"}}"#
+		);
+		write_file(
+			pack_dir.path(),
+			"assets/minecraft/optifine/sky/world0/sky1.properties",
+			SKY_ENTRY
+		);
+		write_file(
+			pack_dir.path(),
+			"assets/minecraft/optifine/sky/world0/cloud.png",
+			&sky_image
+		);
+		write_file(
+			pack_dir.path(),
+			"assets/minecraft/optifine/sky/world0/leftover.png",
+			&sky_image
+		);
+
+		let output_path = output_dir.path().join("pack.zip");
+		let mut global_options = GlobalOptions {
+			skip_unused_optifine_sky_images: skip_unused_images,
+			output_file_path: output_path.clone(),
+			..GlobalOptions::default()
+		};
+		global_options.zip_compression_iterations = 1;
+		if allow_optifine {
+			global_options.allow_mods = MinecraftMod::Optifine.into();
+		}
+
+		let (sender, mut receiver) = tokio::sync::mpsc::channel(64);
+
+		PackSquasher::new()
+			.run(
+				OsFilesystem,
+				SquashOptions {
+					pack_directory: pack_dir.path().to_path_buf(),
+					global_options,
+					file_options: Default::default()
+				},
+				Some(sender)
+			)
+			.expect("Squashing a valid pack should succeed");
+
+		let mut intentionally_skipped = Vec::new();
+		while let Ok(status) = receiver.try_recv() {
+			if let PackSquasherStatus::PackFileProcessed(status) = status {
+				assert!(status.optimization_error().is_none());
+
+				if status.intentionally_skipped() {
+					intentionally_skipped.push(status.path().as_str().to_owned());
+				}
+			}
+		}
+
+		let output = ZipArchive::parse(fs::read(output_path).unwrap()).unwrap();
+		let sky_directory = "assets/minecraft/optifine/sky/world0/";
+
+		if skip_unused_images && allow_optifine {
+			assert_eq!(
+				intentionally_skipped,
+				[format!("{sky_directory}leftover.png")]
+			);
+			assert!(!output.contains(&format!("{sky_directory}leftover.png")));
+		} else {
+			assert!(intentionally_skipped.is_empty());
+			// Without OptiFine support, the whole sky directory is not included anyway,
+			// so only check the result if OptiFine support was enabled
+			assert_eq!(
+				output.contains(&format!("{sky_directory}leftover.png")),
+				allow_optifine
+			);
+		}
+
+		if allow_optifine {
+			assert!(output.contains(&format!("{sky_directory}cloud.png")));
+			assert!(output.contains(&format!("{sky_directory}sky1.properties")));
+		}
+	}
+}
diff --git a/packages/packsquash/src/vfs.rs b/packages/packsquash/src/vfs.rs
index 14c5b9a..33ec9b4 100644
--- a/packages/packsquash/src/vfs.rs
+++ b/packages/packsquash/src/vfs.rs
@@ -5,7 +5,7 @@ use std::time::SystemTime;
 use std::{fs::FileType, io, path::Path};
 
 use crate::RelativePath;
-use tokio::io::AsyncRead;
+use tokio::io::{AsyncRead, AsyncReadExt};
 
 pub mod os_fs;
 
@@ -80,3 +80,20 @@ pub struct VfsPackFileMetadata {
 	/// time to the creation time.
 	pub modification_time: Option<SystemTime>
 }
+
+/// Reads everything that `reader` yields, using `size_hint` to preallocate the buffer.
+pub(crate) async fn read_to_end(
+	mut reader: impl AsyncRead + Unpin,
+	size_hint: u64
+) -> io::Result<Vec<u8>> {
+	let mut data = Vec::with_capacity(usize::try_from(size_hint).unwrap_or(0));
+	reader.read_to_end(&mut data).await?;
+	Ok(data)
+}
+
+/// Reads the whole file at the given path of a virtual filesystem, returning `None` if
+/// it does not exist or any I/O error happens.
+pub(crate) async fn read_file<V: VirtualFileSystem>(vfs: &V, path: &Path) -> Option<Vec<u8>> {
+	let file = vfs.open(path).ok()?;
+	read_to_end(file.file_read, file.file_size_hint).await.ok()
+}
