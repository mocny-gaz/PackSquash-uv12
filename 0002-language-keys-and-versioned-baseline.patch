+fn language_entry(root: &Path, file: &str, pack_data: &[u8], baseline_data: &[u8]) -> (TempDir, VfsPackFileIterEntry) {
+	let baseline_dir = temp_dir();
+	write_file(baseline_dir.path(), file, baseline_data);
